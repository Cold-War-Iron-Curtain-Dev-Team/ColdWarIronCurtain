	name = "FUL_militia_0_entity"
	pdxmesh = "FUL_militia_0_mesh"
	
	default_state = "idle"
	state = { name = "attack"			animation = "charge_rifle" 				animation_blend_time = 0.0  animation_speed = 1.0 looping = no next_state = "attack" chance = 2 propagate_state = { rifle1 = "idle" } }
	state = { name = "attack"			animation = "charge_rifle_shoot" 			animation_blend_time = 0.0  animation_speed = 1.0 looping = no next_state = "attack" chance = 1 }

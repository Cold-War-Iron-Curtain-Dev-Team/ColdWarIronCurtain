# CWIC: heavy-storm clouds plus a tropical cyclone; the cyclone only shows over tropical seas (gfx/FX/particle.shader)
entity = {
	name = "cwic_storm_clouds_entity"
	cull_radius = 10

	default_state = "idle"
	state = { name = "idle" state_time = 2 looping = no
		event = { time = 0 particle = "lightning_storm_clouds_particle" keep_particle = yes }
		event = { time = 0 particle = "cwic_cyclone_particle" keep_particle = yes }
	}
}

entity = {
	name = "cwic_storm_small_clouds_entity"
	cull_radius = 10

	default_state = "idle"
	state = { name = "idle" state_time = 2 looping = no
		event = { time = 0 particle = "lightning_storm_small_clouds_particle" keep_particle = yes }
		event = { time = 0 particle = "cwic_cyclone_small_particle" keep_particle = yes }
	}
}


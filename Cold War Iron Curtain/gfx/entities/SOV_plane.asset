
# OLD FIGHTER #
# yak-3 #
entity = {
	name = "SOV_fighter_equipment_1_entity"
	pdxmesh = "SOV_yak3_mesh"
	state = { name = "fire" animation = "idle" 
		event = { time = 0 node = "gun1"	particle = "plane_mg_muzzle_particle" keep_particle = yes sound = { soundeffect = "ShVaksgun_fire" } }
		event = { time = 0.02 node = "gun2"	particle = "plane_mg_muzzle_particle" keep_particle = yes }
		event = { time = 0.02 node = "gun3"	particle = "plane_mg_muzzle_particle" keep_particle = yes }
		event = { trigger_once = yes sound = { soundeffect = "distance_ShVaksgun_fire" } }
	}
	state = { name = "bomb" animation = "idle" 
		event = { time = 0 particle = "bomb_particle" keep_particle = yes sound = { soundeffect = "airplane_bomb" } }
	}
	state = { name = "idle" animation = "idle"
		event = { trigger_once = yes sound = { soundeffect = "propairplane_idle" } }
		event = { trigger_once = yes sound = { soundeffect = "distance_propairplane_idle" } }
	}
	state = { name = "crash" animation = "idle" 
		
		
		event = { trigger_once = yes sound = { soundeffect = "distance_airplane_crash" } }
		}
	state = { name = "explode" animation = "idle" 
		event = { time = 0 particle = "vehicle_explode_effect" keep_particle = yes }
		event = { trigger_once = yes sound = { soundeffect = "distance_airplane_crash" } }
	}
	scale = 0.19
}

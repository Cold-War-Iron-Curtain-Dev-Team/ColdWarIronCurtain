	# ============================================================
	# THE COUNCIL PANEL
	#
	# Sits to the right of the UN tab and answers the two questions the table
	# art cannot: WHO is in each seat, and how are they voting. Real flags -
	# image = "[THIS.GetFlag]" in the scripted GUI, same as the Toronto Treaty
	# member list - and the vote comes from the country flags the vote effects
	# already set.
	#
	# Under it, the blocs: who leads each one, how many countries it speaks
	# for, and which way its leader is voting. That is the lobbying target.
	# ============================================================
	containerWindowType = {
		name = "un_council_list"
		position = { x = 548 y = 78 }
		size = { width = 320 height = 1000 }
		moveable = no
		clipping = no
		fade_time = 300
		fade_type = linear

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_plain_bg"
		}

		instantTextboxType = {
			name = "un_bloc_title"
			position = { x = 16 y = 44 }
			font = "hoi_20b"
			borderSize = { x = 0 y = 0 }
			text = "UN_BLOC_TITLE"
			maxWidth = 280
			maxHeight = 24
			format = left
		}

		containerWindowType = {
			name = "un_bloc_holder"
			position = { x = 10 y = 76 }
			size = { width = 300 height = 880 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"

			gridboxtype = {
				name = "un_bloc_grid"
				position = { x = 0 y = 0 }
				size = { width = 300 height = 100%% }
				slotsize = { width = 290 height = 46 }
				max_slots_horizontal = 1
				add_horizontal = yes
			}
		}
	}

	# One seat. The flag sprite is a placeholder - the scripted GUI replaces it

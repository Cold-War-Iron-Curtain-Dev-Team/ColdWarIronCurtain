		# ---- THE COUNCIL, AS FLAGS ----
		# What used to be forty-five pieces of art: one full-panel PNG per seat
		# per vote state, plus a painted strip of the five permanent flags. None
		# of it said who was sitting anywhere, and ten of the fifteen seats were
		# never filled at all.
		#
		# Now both rows are dynamic lists of real flags. The top row is the five
		# permanent members - the China seat follows whoever holds the idea, so
		# it becomes the PRC the moment content moves it. The rows under it are
		# the elected seats, re-elected every two years.
		containerWindowType = {
			name = "un_perm_seat_holder"
			position = { x = -190 y = 75 }
			size = { width = 512 height = 74 }
			clipping = no

			gridboxtype = {
				name = "un_perm_seat_grid"
				position = { x = 0 y = 0 }
				size = { width = 512 height = 74 }
				slotsize = { width = 102 height = 72 }
				max_slots_horizontal = 5
				add_horizontal = yes
			}
		}


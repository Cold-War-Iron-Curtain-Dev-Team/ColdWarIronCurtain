	#Decision Part
    containerWindowType = {
		name = "malaya_state_decisions_list_menu"
		position = { x = 50 y = 185 }
		size = { width = 500 height = 363 }
		fade_time = 300
		fade_type = linear
		moveable = no 
		clipping = yes

		containerWindowType = {
			name = "malaya_state_decisions_list_menu_grid"
			position = {x=0 y=0}
			size = { width = 700 height = 363 }
			margin = { top = 5 bottom = 15 left = 5 }
			clipping = yes

			verticalScrollbar = "left_vertical_slider"

			# background is necesarry for scrollbars to work
			background = {
				name = "Background"
				quadTextureSprite = "GFX_MAL_State_Decisions_BG"
			}
			
			# this grid will be dynamically populated
			gridboxtype = {
				name = "malaya_state_decisions_listing_grid"
				position = { x = 12 y = -8 }
				size = { width = 400 height = 100% }
				slotsize = { width = 180 height = 40 }
				max_slots_horizontal = 1
				add_horizontal = yes
			}   
		}
	}


		# Scrolls once more than four dossier cards are revealed.
		containerWindowType = {
			name = "USA_mkultra_dossier_scroll"
			position = { x = 12 y = 324 }
			size = { width = 488 height = 350 }
			clipping = yes
			verticalScrollbar = "right_vertical_slider"

			# A background is required for the scrollbar to receive input.
			background = {
				name = "Background"
				quadTextureSprite = "GFX_gui_arab_league_transparent_resolution_bg"
			}

			gridboxtype = {
				name = "USA_mkultra_dossier_grid"
				position = { x = 0 y = 0 }
				size = { width = 476 height = 100% }
				slotsize = { width = 476 height = 86 }
				max_slots_horizontal = 1
				add_horizontal = yes
			}
		}
	}


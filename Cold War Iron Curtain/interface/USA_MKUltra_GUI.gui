guiTypes = {
	# Standalone, read-only records room. Material actions remain ordinary
	# decisions and missions in the MKULTRA decision category.
	containerWindowType = {
		name = "USA_MKUltra_dashboard_window"
		position = { x = 0 y = 0 }
		size = { width = 500 height = 680 }
		orientation = center
		origo = center
		moveable = yes
		clipping = no
		click_to_front = yes

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_1b_border"
		}

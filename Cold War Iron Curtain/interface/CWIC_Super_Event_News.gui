guiTypes = {

	# ---------------------------------------------------------------
	# Topbar buttons (News + Filter). Shown via parent_window_token = top_bar.
	# Reposition x/y here if they overlap other topbar elements.
	# ---------------------------------------------------------------
	containerWindowType = {
		name = "CWIC_se_topbar_buttons"
		position = { x = 1120 y = 6 }
		clipping = no
		size = { width = 120 height = 30 }
		Orientation = UPPER_LEFT

		buttonType = {
			name = "CWIC_news_button"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_smallestboxgreen"
			buttonFont = "hoi_16mbs"
			buttonText = "News"
			clicksound = click_default
		}
		buttonType = {
			name = "CWIC_settings_button"
			position = { x = 60 y = 0 }
			quadTextureSprite = "GFX_smallestboxgreen"
			buttonFont = "hoi_16mbs"
			buttonText = "Filter"
			clicksound = click_default
		}
	}

	# ---------------------------------------------------------------
	# Latest News window (last 10 super events, newest first)
	# ---------------------------------------------------------------
	containerWindowType = {
		name = "CWIC_News_Window"
		size = { width = 380 height = 560 }
		position = { x = 0 y = 0 }
		Orientation = center
		Origo = center
		clipping = no
		moveable = yes

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_2b_border_crt"
		}

		instantTextBoxType = {
			name = "CWIC_news_title"
			position = { x = 0 y = 14 }
			font = "hoi_36header"
			text = "Latest News"
			maxWidth = 380
			maxHeight = 34
			format = center
			fixedsize = yes
			alwaystransparent = yes
		}

		buttonType = {
			name = "CWIC_news_close"
			position = { x = 300 y = 12 }
			quadTextureSprite = "GFX_smallestboxgreen"
			buttonFont = "hoi_16mbs"
			buttonText = "X"
			clicksound = click_default
		}

		containerWindowType = {
			name = "CWIC_news_scroll"
			position = { x = 5 y = 56 }
			size = { width = 380 height = 486 }
			clipping = yes

			verticalScrollbar = "left_vertical_slider"
			margin = { top = 10 bottom = 10 left = 20 right = 20 }
			smooth_scrolling = yes
			scroll_wheel_factor = 40
			# background is necessary for scrollbars to work
			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}

			gridBoxType = {
				name = "CWIC_news_gridbox"
				position = { x = 6 y = 4 }
				size = { width = 330 height = 100% }
				slotsize = { width = 330 height = 86 }
				max_slots_horizontal = 1
				add_horizontal = no
				format = "UPPER_LEFT"
			}
		}
	}

	# ---------------------------------------------------------------
	# Single Latest News entry (CWIC_se_view = this entry's super event id)
	# ---------------------------------------------------------------
	containerWindowType = {
		name = "CWIC_news_entry"
		size = { width = 338 height = 86 }
		position = { x = 0 y = 0 }

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_thin_border"
		}

		iconType = {
			name = "CWIC_news_entry_img"
			spriteType = "GFX_Super_Event_Underlay"
			position = { x = 20 y = 15 }
			scale = 0.11
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "CWIC_news_entry_title"
			position = { x = 92 y = 14 }
			font = "hoi_16mbs"
			text = "[get_se_list_title]"
			maxWidth = 150
			maxHeight = 58
			format = left
			fixedsize = yes
			alwaystransparent = yes
		}
		buttonType = {
			name = "CWIC_news_entry_button"
			position = { x = 100 y = 30 }
			quadTextureSprite = "GFX_button_148x34"
			scale = 0.55
			buttonFont = "hoi_16mbs"
			buttonText = "View"
			clicksound = click_default
		}
	}

	# ---------------------------------------------------------------
	# Super event filter settings window
	# ---------------------------------------------------------------
	containerWindowType = {
		name = "CWIC_SE_Settings_Window"
		size = { width = 360 height = 340 }
		position = { x = 0 y = 0 }
		Orientation = center
		Origo = center
		clipping = no
		moveable = yes

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_2b_border_crt"
		}

		instantTextBoxType = {
			name = "CWIC_settings_title"
			position = { x = 0 y = 12 }
			font = "bombardier_20"
			text = "Super Event Popups"
			maxWidth = 360
			maxHeight = 26
			format = center
			fixedsize = yes
			alwaystransparent = yes
		}
		buttonType = {
			name = "CWIC_settings_close"
			position = { x = 300 y = 10 }
			quadTextureSprite = "GFX_smallestboxgreen"
			buttonFont = "hoi_16mbs"
			buttonText = "X"
			clicksound = click_default
		}

		instantTextBoxType = {
			name = "CWIC_settings_current"
			position = { x = 24 y = 48 }
			font = "hoi_16mbs"
			text = "Showing: [get_CWIC_filter_mode]"
			maxWidth = 320
			maxHeight = 22
			format = left
			fixedsize = yes
			alwaystransparent = yes
		}

		buttonType = {
			name = "CWIC_mode_all"
			position = { x = 24 y = 80 }
			quadTextureSprite = "GFX_button_148x34"
			scale = 2.1
			buttonFont = "hoi_16mbs"
			buttonText = "Show all events"
			clicksound = click_default
		}
		buttonType = {
			name = "CWIC_mode_own"
			position = { x = 24 y = 126 }
			quadTextureSprite = "GFX_button_148x34"
			scale = 2.1
			buttonFont = "hoi_16mbs"
			buttonText = "My country + majors"
			clicksound = click_default
		}
		buttonType = {
			name = "CWIC_mode_majors"
			position = { x = 24 y = 172 }
			quadTextureSprite = "GFX_button_148x34"
			scale = 2.1
			buttonFont = "hoi_16mbs"
			buttonText = "Only major powers"
			clicksound = click_default
		}
		buttonType = {
			name = "CWIC_mode_off"
			position = { x = 24 y = 218 }
			quadTextureSprite = "GFX_button_148x34"
			scale = 2.1
			buttonFont = "hoi_16mbs"
			buttonText = "Disable all popups"
			clicksound = click_default
		}

		instantTextBoxType = {
			name = "CWIC_settings_hint"
			position = { x = 24 y = 268 }
			font = "hoi_16mbs"
			text = "All events are still saved to Latest News."
			maxWidth = 320
			maxHeight = 40
			format = left
			fixedsize = yes
			alwaystransparent = yes
		}
	}
}

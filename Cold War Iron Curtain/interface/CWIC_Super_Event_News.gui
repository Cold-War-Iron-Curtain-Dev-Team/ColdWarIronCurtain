guiTypes = {

	# ---------------------------------------------------------------
	# Latest News window (last 10 super events, newest first)
	# ---------------------------------------------------------------
	containerWindowType = {
		name = "CWIC_News_Window"
		size = { width = 380 height = 560 }
		position = { x = 0 y = 0 }
		Orientation = center
		Origo = center
		clipping = no
		moveable = yes

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_2b_border_crt"
		}

		instantTextBoxType = {
			name = "CWIC_news_title"
			position = { x = 0 y = 14 }
			font = "hoi_36header"
			text = "Latest News"
			maxWidth = 380
			maxHeight = 34
			format = center
			fixedsize = yes
			alwaystransparent = yes
		}

		buttonType = {
			name = "CWIC_news_close"
			position = { x = 340 y = 5 }
			quadTextureSprite = "GFX_closebutton"
			clicksound = click_default
		}

		containerWindowType = {
			name = "CWIC_news_scroll"
			position = { x = 5 y = 56 }
			size = { width = 380 height = 486 }
			clipping = yes

			verticalScrollbar = "left_vertical_slider"
			margin = { top = 10 bottom = 10 left = 20 right = 20 }
			smooth_scrolling = yes
			scroll_wheel_factor = 40
			# background is necessary for scrollbars to work
			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_transparent"
			}

			gridBoxType = {
				name = "CWIC_news_gridbox"
				position = { x = 6 y = 4 }
				size = { width = 330 height = 100% }
				slotsize = { width = 330 height = 86 }
				max_slots_horizontal = 1
				add_horizontal = no
				format = "UPPER_LEFT"
			}
		}
	}

	# ---------------------------------------------------------------
	# Single Latest News entry (CWIC_se_view = this entry's super event id)
	# ---------------------------------------------------------------
	containerWindowType = {
		name = "CWIC_news_entry"
		size = { width = 338 height = 86 }
		position = { x = 0 y = 0 }

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_thin_border"
		}

		iconType = {
			name = "CWIC_news_entry_img"
			spriteType = "GFX_Super_Event_Underlay"
			position = { x = 20 y = 15 }
			scale = 0.11
			alwaystransparent = yes
		}
		instantTextBoxType = {
			name = "CWIC_news_entry_title"
			position = { x = 92 y = 14 }
			font = "hoi_16mbs"
			text = "[get_se_list_title]"
			maxWidth = 150
			maxHeight = 58
			format = left
			fixedsize = yes
			alwaystransparent = yes
		}
		buttonType = {
			name = "CWIC_news_entry_button"
			position = { x = 100 y = 30 }
			quadTextureSprite = "GFX_button_148x34"
			scale = 0.55
			buttonFont = "hoi_16mbs"
			buttonText = "View"
			clicksound = click_default
		}
	}
}

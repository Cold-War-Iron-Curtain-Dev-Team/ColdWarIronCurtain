


espionage_casualty_script = {
    set_variable_to_random = espionage_casualty_rng_1
    set_variable_to_random = espionage_casualty_rng_2
    set_variable_to_random = espionage_casualty_rng_3
    set_variable_to_random = espionage_casualty_rng_4
    set_variable_to_random = espionage_casualty_rng_5

    if = {
        limit = {
            check_variable = { espionage_casualty_rng_1 > slot_1_casualty_chance }
        }
        add_to_variable = { current_espionage_casualty_count = 1 }
    }
    if = {
        limit = {
            check_variable = { espionage_casualty_rng_2 > slot_1_casualty_chance }
        }
        add_to_variable = { current_espionage_casualty_count = 1 }
    }
    if = {
        limit = {
            check_variable = { espionage_casualty_rng_3 > slot_1_casualty_chance }
        }
        add_to_variable = { current_espionage_casualty_count = 1 }
    }
    if = {
        limit = {
            check_variable = { espionage_casualty_rng_4 > slot_1_casualty_chance }
        }
        add_to_variable = { current_espionage_casualty_count = 1 }
    }
    if = {
        limit = {
            check_variable = { espionage_casualty_rng_5 > slot_1_casualty_chance }
        }
        add_to_variable = { current_espionage_casualty_count = 1 }
    }
    while_loop_effect = {
        limit = {
            check_variable = { current_espionage_casualty_count > 0 }
        }
        add_to_variable = { current_espionage_casualty_count = -1 }
        set_variable = { kia_rate = 30 }
        set_variable = { cap_rate = 20 }
        set_variable = { wia_rate = 50 }

        set_variable = { kia_total = 0 }
        set_variable = { cap_total = 0 }
        set_variable = { wia_total = 0 }
        random_list = {
            var:kia_rate = {
                add_to_variable = { kia_total = 1 }
            }
            var:cap_rate = {
                add_to_variable = { cap_total = 1 }
            }
            var:wia_rate = {
                add_to_variable = { wia_total = 1 }
            }
        }
    }
    casualty_trait_impact_adjustment = yes              #Adjust the Rates Noted Above Depending on Specific Traits
    casualty_trait_downgrade_impact_adjustment = yes    #Adjust Any Downward If Trait Applicable
    set_variable = { operative_1_exposure_rate = 4 }
    set_variable = { operative_2_exposure_rate = 4 }
    set_variable = { operative_3_exposure_rate = 4 }
    set_variable = { operative_4_exposure_rate = 4 }
    set_variable = { operative_5_exposure_rate = 4 }
    casualty_exposure_rate_adjustment = yes                 #Adjust Casualty Rate based on Traits
    while_loop_effect = {
        limit = {
            check_variable = { kia_total > 0 }
        }
        add_to_variable = { kia_total = -1 }
        random_list = {
            var:operative_1_exposure_rate = {
                set_variable = { operative_1_exposure_rate = 0 }
                set_variable = { operative_1_kia = 1 }
            }
            var:operative_2_exposure_rate = {
                set_variable = { operative_2_exposure_rate = 0 }
                set_variable = { operative_2_kia = 1 }
            }
            var:operative_3_exposure_rate = {
                set_variable = { operative_3_exposure_rate = 0 }
                set_variable = { operative_3_kia = 1 }
            }
            var:operative_4_exposure_rate = {
                set_variable = { operative_4_exposure_rate = 0 }
                set_variable = { operative_4_kia = 1 }
            }
            var:operative_5_exposure_rate = {
                set_variable = { operative_5_exposure_rate = 0 }
                set_variable = { operative_5_kia = 1 }
            }
        }
    }
    while_loop_effect = {
        limit = {
            check_variable = { wia_total > 0 }
        }
        add_to_variable = { wia_total = -1 }
        random_list = {
            var:operative_1_exposure_rate = {
                set_variable = { operative_1_exposure_rate = 0 }
                set_variable = { operative_1_wia = 1 }

                set_variable = { operative_slot = 1 }
                casualty_trait_downgrade_impact_adjustment = yes
            }
            var:operative_2_exposure_rate = {
                set_variable = { operative_2_exposure_rate = 0 }
                set_variable = { operative_2_wia = 1 }
            }
            var:operative_3_exposure_rate = {
                set_variable = { operative_3_exposure_rate = 0 }
                set_variable = { operative_3_wia = 1 }
            }
            var:operative_4_exposure_rate = {
                set_variable = { operative_4_exposure_rate = 0 }
                set_variable = { operative_4_wia = 1 }
            }
            var:operative_5_exposure_rate = {
                set_variable = { operative_5_exposure_rate = 0 }
                set_variable = { operative_5_wia = 1 }
            }
        }
    }
    while_loop_effect = {
        limit = {
            check_variable = { cap_total > 0 }
        }
        add_to_variable = { cap_total = -1 }
        random_list = {
            var:operative_1_exposure_rate = {
                set_variable = { operative_1_exposure_rate = 0 }
                set_variable = { operative_1_cap = 1 }
            }
            var:operative_2_exposure_rate = {
                set_variable = { operative_2_exposure_rate = 0 }
                set_variable = { operative_2_cap = 1 }
            }
            var:operative_3_exposure_rate = {
                set_variable = { operative_3_exposure_rate = 0 }
                set_variable = { operative_3_cap = 1 }
            }
            var:operative_4_exposure_rate = {
                set_variable = { operative_4_exposure_rate = 0 }
                set_variable = { operative_4_cap = 1 }
            }
            var:operative_5_exposure_rate = {
                set_variable = { operative_5_exposure_rate = 0 }
                set_variable = { operative_5_cap = 1 }
            }
        }
    }
}

casualty_trait_impact_adjustment = {    #KIA and Captured Reduction
    #Captured Section
    meta_effect = { 
        text = {
            set_variable = { cap_reduction_rate = squad_combined_escape_chance^[CURRENT_PAGE] }
        }
        CURRENT_PAGE = "[?current_page]"
    }    
    set_variable = { cap_reduction = 0 }
    for_loop_effect = {
        end = cap_total
        value = v
        set_variable_to_random = CAP_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { CAP_Recovery_Chance < cap_reduction_rate }
                    check_variable = { CAP_Recovery_Chance = cap_reduction_rate }
                }
            }
            add_to_variable = { cap_reduction = 1 }
        }
    }
    subtract_from_variable = { cap_total = cap_reduction }
    
    #KIA Section 
    meta_effect = { 
        text = {
            set_variable = { kia_reduction_rate = squad_combined_group_kia_reduction_rate^[CURRENT_PAGE] }
        }
        CURRENT_PAGE = "[?current_page]"
    }    
    set_variable = { kia_reduction = 0 }
    for_loop_effect = {
        end = kia_total
        value = v
        set_variable_to_random = KIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { KIA_Recovery_Chance < kia_reduction_rate }
                    check_variable = { KIA_Recovery_Chance = kia_reduction_rate }
                }
            }
            add_to_variable = { kia_reduction = 1 }
        }
    }
    subtract_from_variable = { kia_total = kia_reduction }
    add_to_variable = { wia_total = kia_reduction }
}
casualty_trait_downgrade_impact_adjustment = {  #WIA Adjustment
    #squad_combined_recovery_duration_rate
    set_variable = { WIA_Level_1 = 0 }  #Lowest
    set_variable = { WIA_Level_2 = 0 }  #Middle
    set_variable = { WIA_Level_3 = 0 }  #Severe
    set_variable = { wia_reduction_rate = 0 }
    meta_effect = { 
        text = {
            set_variable = { wia_reduction_rate = squad_combined_recovery_duration_rate^[CURRENT_PAGE] }
        }
        CURRENT_PAGE = "[?current_page]"
    }    
    set_variable_to_random = {
        var = WIA_Level
        min = 1
        max = 3
        integer = yes
    }
    if = {
        limit = {
            check_variable = { WIA_Level = 1 }
        }
        set_variable_to_random = WIA_Recovery_Chance
        meta_effect = { 
            text = {
                set_variable = { operative_[CURRENT_SLOT]_wia^[CURRENT_PAGE] = 1 }
            }
            CURRENT_PAGE = "[?current_page]"
            CURRENT_SLOT = "[?operative_slot]"
        }   
        if = {
            limit = {
                OR = {
                    check_variable = { WIA_Recovery_Chance < wia_reduction_rate }
                    check_variable = { WIA_Recovery_Chance = wia_reduction_rate }
                }
            }
            set_variable = { WIA_Level_1 = 0 }
            meta_effect = { 
                text = {
                    set_variable = { operative_[CURRENT_SLOT]_wia^[CURRENT_PAGE] = 0 }
                }
                CURRENT_PAGE = "[?current_page]"
                CURRENT_SLOT = "[?operative_slot]"
            }   
        }
    }
    else_if = {
        limit = {
            check_variable = { WIA_Level = 2 }
        }
        meta_effect = { 
            text = {
                set_variable = { operative_[CURRENT_SLOT]_wia^[CURRENT_PAGE] = 2 }
            }
            CURRENT_PAGE = "[?current_page]"
            CURRENT_SLOT = "[?operative_slot]"
        }   
        set_variable_to_random = WIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { WIA_Recovery_Chance < wia_reduction_rate }
                    check_variable = { WIA_Recovery_Chance = wia_reduction_rate }
                }
            }
            meta_effect = { 
                text = {
                    set_variable = { operative_[CURRENT_SLOT]_wia^[CURRENT_PAGE] = 1 }
                }
                CURRENT_PAGE = "[?current_page]"
                CURRENT_SLOT = "[?operative_slot]"
            }   
        }
    }
    else_if = {
        limit = {
            check_variable = { WIA_Level = 3 }
        }
        meta_effect = { 
            text = {
                set_variable = { operative_[CURRENT_SLOT]_wia^[CURRENT_PAGE] = 3 }
            }
            CURRENT_PAGE = "[?current_page]"
            CURRENT_SLOT = "[?operative_slot]"
        }   
        set_variable_to_random = WIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { WIA_Recovery_Chance < wia_reduction_rate }
                    check_variable = { WIA_Recovery_Chance = wia_reduction_rate }
                }
            }
            meta_effect = { 
                text = {
                    set_variable = { operative_[CURRENT_SLOT]_wia^[CURRENT_PAGE] = 2 }
                }
                CURRENT_PAGE = "[?current_page]"
                CURRENT_SLOT = "[?operative_slot]"
            }   
        }
    }
    else = { }
}


casualty_exposure_rate_adjustment = {
    #set_variable = { current_page = selected_squad_slot_1_Current_Page_Ref }
    meta_effect = { 
        text = {
            add_to_variable = { operative_1_exposure_rate = paramilitary_operative_squad_unit_1_casualty_exposure_rate^[CURRENT_PAGE] }
            add_to_variable = { operative_2_exposure_rate = paramilitary_operative_squad_unit_2_casualty_exposure_rate^[CURRENT_PAGE] }
            add_to_variable = { operative_3_exposure_rate = paramilitary_operative_squad_unit_3_casualty_exposure_rate^[CURRENT_PAGE] }
            add_to_variable = { operative_4_exposure_rate = paramilitary_operative_squad_unit_4_casualty_exposure_rate^[CURRENT_PAGE] }
            add_to_variable = { operative_5_exposure_rate = paramilitary_operative_squad_unit_5_casualty_exposure_rate^[CURRENT_PAGE] }
        }
        CURRENT_PAGE = "[?current_page]"
    }    
}
finalize_casualty_impact_on_mission_end = { #Set WIA, Captured and KIA Impacts on Specific Agents/Squads AND Individual KIA Adjustment
    #Check for KIA Adjustment Rate, Fire Script to Check
    if = {
        limit = {
            check_variable = { operative_1_kia = 1 }
        }
        set_variable_to_random = KIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { KIA_Recovery_Chance < paramilitary_operative_squad_unit_1_indiv_kia_reduction_rate^current_page }
                    check_variable = { KIA_Recovery_Chance = paramilitary_operative_squad_unit_1_indiv_kia_reduction_rate^current_page }
                }
            }
            set_variable = { operative_1_kia = 0 }
        }
        else = {
            remove_current_operative_1 = yes
        }
    }
    if = {
        limit = {
            check_variable = { operative_2_kia = 1 }
        }
        set_variable_to_random = KIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { KIA_Recovery_Chance < paramilitary_operative_squad_unit_2_indiv_kia_reduction_rate^current_page }
                    check_variable = { KIA_Recovery_Chance = paramilitary_operative_squad_unit_2_indiv_kia_reduction_rate^current_page }
                }
            }
            set_variable = { operative_2_kia = 0 }
        }
        else = {
            remove_current_operative_2 = yes
        }
    }
    if = {
        limit = {
            check_variable = { operative_3_kia = 1 }
        }
        set_variable_to_random = KIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { KIA_Recovery_Chance < paramilitary_operative_squad_unit_3_indiv_kia_reduction_rate^current_page }
                    check_variable = { KIA_Recovery_Chance = paramilitary_operative_squad_unit_3_indiv_kia_reduction_rate^current_page }
                }
            }
            set_variable = { operative_3_kia = 0 }
        }
        else = {
            remove_current_operative_3 = yes
        }
    }
    if = {
        limit = {
            check_variable = { operative_4_kia = 1 }
        }
        set_variable_to_random = KIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { KIA_Recovery_Chance < paramilitary_operative_squad_unit_4_indiv_kia_reduction_rate^current_page }
                    check_variable = { KIA_Recovery_Chance = paramilitary_operative_squad_unit_4_indiv_kia_reduction_rate^current_page }
                }
            }
            set_variable = { operative_4_kia = 0 }
        }
        else = {
            remove_current_operative_4 = yes
        }
    }
    if = {
        limit = {
            check_variable = { operative_5_kia = 1 }
        }
        set_variable_to_random = KIA_Recovery_Chance
        if = {
            limit = {
                OR = {
                    check_variable = { KIA_Recovery_Chance < paramilitary_operative_squad_unit_5_indiv_kia_reduction_rate^current_page }
                    check_variable = { KIA_Recovery_Chance = paramilitary_operative_squad_unit_5_indiv_kia_reduction_rate^current_page }
                }
            }
            set_variable = { operative_5_kia = 0 }
        }
        else = {
            remove_current_operative_5 = yes
        }
    }
    #WIA

    #Captured
}

 PHASE_3_Operation_TITLE_OP_VALUABLE_INSERTION_FAILURE_20054:0 "Lost in the Surf"
 
 PHASE_3_Operation_TITLE_OP_VALUABLE_MONARCHIST_SUCCESS_20056:0 "The Banner Rises Again"
 PHASE_3_Operation_TITLE_OP_VALUABLE_MONARCHIST_FAILURE_20056:0 "Loyalty Without a Crown"
 
 PHASE_3_Operation_TITLE_OP_VALUABLE_REPUBLICAN_SUCCESS_20057:0 "The People's Flame Ignites"
 PHASE_3_Operation_TITLE_OP_VALUABLE_REPUBLICAN_FAILURE_20057:0 "Idealism in Ashes"
 
 PHASE_3_Operation_TITLE_OP_VALUABLE_CLANS_SUCCESS_20058:0 "Bloodlines Awaken"
 PHASE_3_Operation_TITLE_OP_VALUABLE_CLANS_FAILURE_20058:0 "Kinship Wounded"
 
 PHASE_3_Operation_TITLE_OP_VALUABLE_PSYOPS_SUCCESS_20059:0 "The Faith Resists"
 PHASE_3_Operation_TITLE_OP_VALUABLE_PSYOPS_FAILURE_20059:0 "Hearts Remain Silent"
 
 PHASE_3_Operation_TITLE_OP_VALUABLE_SABOTAGE_SUCCESS_20060:0 "The Arteries Are Cut"
 PHASE_3_Operation_TITLE_OP_VALUABLE_SABOTAGE_FAILURE_20060:0 "Saboteurs Swept Aside"
 
 PHASE_3_Operation_TITLE_OP_VALUABLE_UPRISING_SUCCESS_20061:0 "Albania Rises"
 PHASE_3_Operation_TITLE_OP_VALUABLE_UPRISING_FAILURE_20061:0 "Revolt Crushed at Dawn"
